# Matplotlib style sheet used for Frank's Master's thesis

#---------------------------------------
# FONT
#---------------------------------------
font.family: "serif"
font.serif : "cmr10"
font.size : 12

#---------------------------------------
# LaTeX
#---------------------------------------
text.usetex : False
axes.unicode_minus: False
mathtext.fontset : "cm"
axes.formatter.use_mathtext: True

#---------------------------------------
# X TICKS
#---------------------------------------
xtick.top : True
xtick.minor.visible : True
xtick.minor.ndivs : 5
xtick.major.size : 4
xtick.minor.size : 2
xtick.direction : "in"

#---------------------------------------
# Y TICKS
#---------------------------------------
ytick.right : True
ytick.minor.visible : True
ytick.minor.ndivs : 5
ytick.major.size : 4
ytick.minor.size : 2
ytick.direction : "in"

#---------------------------------------
# GRID
#---------------------------------------
grid.linewidth : 0.5
grid.color : "gray"
grid.linestyle : "-"
grid.alpha : 1

#---------------------------------------
# LEGEND
#---------------------------------------
legend.framealpha : 1
legend.shadow : True
legend.edgecolor : 0.1
legend.frameon : True
legend.markerscale : 1.5

#---------------------------------------
# SCATTER
#---------------------------------------
scatter.marker : "x"

#---------------------------------------
# FIGURE
#---------------------------------------
figure.autolayout : True
figure.dpi : 100

#---------------------------------------
# SAVING FIGURES
#---------------------------------------
savefig.dpi : 400
savefig.format : png
savefig.pad_inches : 0.1
